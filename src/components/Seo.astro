---
import { ORIGIN, SITE } from '../consts';

export interface Props {
  title: string;
  description?: string;
  /** Appended to <title> unless this page is the site root. */
  bareTitle?: boolean;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  publishedTime?: string;
  modifiedTime?: string;
  keywords?: string[];
  noindex?: boolean;
  /** Extra <meta name> tags, used for Highwire citation data. */
  metaTags?: Array<{ name: string; content: string }>;
  /** One or more JSON-LD graphs. */
  jsonLd?: unknown[];
}

const {
  title,
  description = SITE.description,
  bareTitle = false,
  image = '',
  imageAlt = SITE.name,
  type = 'website',
  publishedTime,
  modifiedTime,
  keywords = [],
  noindex = false,
  metaTags = [],
  jsonLd = [],
} = Astro.props;

/* Astro.url.pathname already carries the base, so canonicals build on the
   origin alone. Adding SITE.url here would double the subpath. */
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', ORIGIN).href;
const fullTitle = bareTitle ? title : `${title} | ${SITE.name}`;
const imageUrl = new URL(image, ORIGIN).href;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
{noindex
  ? <meta name="robots" content="noindex, nofollow" />
  : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
<meta name="author" content={SITE.name} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content="en_CA" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

{metaTags.map((tag) => <meta name={tag.name} content={tag.content} />)}

{jsonLd.map((graph) => (
  <script type="application/ld+json" set:html={JSON.stringify(graph)} is:inline />
))}
