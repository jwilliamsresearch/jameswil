---
import { withBase } from '../../lib/paths';
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import { breadcrumbSchema, creativeWorkSchema } from '../../lib/schema';
import { deckUrl, lecturesFor } from '../../lib/lectures';

export const getStaticPaths: GetStaticPaths = async () => {
  const courses = await getCollection('teaching', ({ data }) => !data.draft);
  return courses.map((course) => ({
    params: { slug: course.id },
    props: { course },
  }));
};

const { course } = Astro.props;
const { Content } = await render(course);
const d = course.data;
const path = `/teaching/${course.id}`;

// Decks are served from a separate deployment at lectures.jameswil.com.
const lectures = lecturesFor(d.code);
---

<BaseLayout
  title={d.code ? `${d.code}: ${d.title}` : d.title}
  description={d.summary}
  type="article"
  keywords={d.tags}
  modifiedTime={d.updated?.toISOString()}
  jsonLd={[
    creativeWorkSchema({
      type: 'Course',
      name: d.code ? `${d.code}: ${d.title}` : d.title,
      description: d.summary,
      path,
      dateModified: d.updated,
      keywords: d.tags,
    }),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Teaching', path: '/teaching' },
      { name: d.title, path },
    ]),
  ]}
>
  <PageHead label={d.code ?? 'Module'} title={d.title} lead={d.summary} document>
    <dl class="facts" style="margin-top:2.5rem">
      <dt>When</dt>
      <dd>
        {d.year}, {d.semester}
      </dd>
      {d.institution && (<><dt>Institution</dt><dd>{d.institution}</dd></>)}
      {d.level && (<><dt>Level</dt><dd>{d.level}</dd></>)}
      {d.credits && (<><dt>Credits</dt><dd>{d.credits}</dd></>)}
      {d.cohort && (<><dt>Cohort</dt><dd>{d.cohort}</dd></>)}
      {d.history.length > 0 && (
        <>
          <dt>Also taught</dt>
          <dd>{d.history.map((h) => `${h.year}, ${h.semester}`).join(' · ')}</dd>
        </>
      )}
      {d.links.length > 0 && (
        <>
          <dt>Links</dt>
          <dd>
            {d.links.map((link, i) => (
              <>
                {i > 0 && ' · '}
                <a href={withBase(link.href)} rel="noopener">{link.label}</a>
              </>
            ))}
          </dd>
        </>
      )}
    </dl>
  </PageHead>

  {(d.logo || d.departmentLogo) && (
    <div style="border-bottom:1px solid var(--line);background:#fff;padding:1.5rem 0;">
      <div class="wrap" style="display:flex;justify-content:center;align-items:center;gap:1.5rem;flex-wrap:wrap;">
        {d.logo && (
          <Image src={d.logo} alt={d.institution ?? ''} height={40} layout="none" style="height:2.5rem;width:auto;object-fit:contain;opacity:0.8;display:block;" loading="lazy" />
        )}
        {d.logo && d.departmentLogo && (
          <span aria-hidden="true" style="width:1px;height:2rem;background:var(--line);"></span>
        )}
        {d.departmentLogo && (
          <Image src={d.departmentLogo} alt="" height={40} layout="none" style="height:1.75rem;width:auto;object-fit:contain;display:block;" loading="lazy" />
        )}
      </div>
    </div>
  )}

  <section class="section">
    <div class="wrap">
      <div class="doc-grid">
        <article class="doc-main prose">
          <Content />
        </article>

        <aside class="doc-aside" aria-label="Sessions">
          {lectures ? (
            <>
              <p class="label">Sessions</p>
              <ol class="session-list">
                {lectures.sessions.map((session) => (
                  <li>
                    <a href={deckUrl(session.url)} rel="noopener">
                      <span class="session-n">{String(session.n).padStart(2, '0')}</span>
                      <span class="session-title">{session.title}</span>
                    </a>
                  </li>
                ))}
              </ol>
              <p class="session-note">
                Slides open in the browser. Arrow keys move through a deck,
                shift with the arrows changes deck.
              </p>
            </>
          ) : (
            <>
              <p class="label">Sessions</p>
              <p class="session-note">Slides for this module are not published.</p>
            </>
          )}
        </aside>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <a class="arrow" href={withBase('/teaching')}>Back to all teaching</a>
    </div>
  </section>
</BaseLayout>
