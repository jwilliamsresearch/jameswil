---
import { withBase } from '../lib/paths';
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Metrics from '../components/Metrics.astro';
import { SITE } from '../consts';
import { personSchema, breadcrumbSchema } from '../lib/schema';

const page = await getEntry('pages', 'about');
if (!page) throw new Error('Missing src/content/pages/about.md');

const { Content, headings } = await render(page);
const d = page.data;
---

<BaseLayout
  title="About: Geospatial Data Science"
  description={d.description ?? SITE.description}
  type="profile"
  modifiedTime={d.updated?.toISOString()}
  jsonLd={[
    personSchema(),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'About', path: '/about' },
    ]),
  ]}
>
  <PageHead label={d.label ?? 'About'} title={d.title} lead={d.lead} />

  {/* Numbers before prose, matching the project pages. These are the strongest
      claims on the site and they were previously buried mid-paragraph. */}
  <Metrics items={d.metrics} label="Track record" />

  <section class="section">
    <div class="wrap">
      <div class="doc-grid">
        <article class="doc-main prose">
          <Content />
        </article>

        <aside class="doc-aside">
          <nav class="toc" aria-label="On this page">
            <p class="label">On this page</p>
            <ul>
              {headings
                .filter((h) => h.depth === 2)
                .map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
            </ul>
          </nav>
        </aside>
      </div>
    </div>
  </section>

  {d.affiliations.length > 0 && (
    <section class="section funders" aria-label="Institutions and funders">
      <div class="wrap">
        <p class="label" style="margin-bottom:1.25rem">Institutions and funders</p>
        <ul class="funder-logos">
          {d.affiliations.map((a) => (
            <li>
              {a.href ? (
                <a href={a.href} rel="noopener" aria-label={a.name} title={a.name}>
                  <Image src={a.logo} alt={a.name} widths={[240, 480]} sizes="240px" loading="lazy" />
                </a>
              ) : (
                <Image src={a.logo} alt={a.name} widths={[240, 480]} sizes="240px" loading="lazy" />
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="cta">
    <div class="wrap">
      <p class="label" style="margin-bottom:1.25rem">Contact</p>
      <a class="big" href={withBase('/contact')}>Get in<br /><span>touch →</span></a>
    </div>
  </section>
</BaseLayout>
