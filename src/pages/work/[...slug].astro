---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import { breadcrumbSchema, creativeWorkSchema } from '../../lib/schema';

export const getStaticPaths: GetStaticPaths = async () => {
  const projects = await getCollection('work', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
};

const { project } = Astro.props;
const { Content, headings } = await render(project);
const d = project.data;
const path = `/work/${project.id}`;
---

<BaseLayout
  title={d.title}
  description={d.summary}
  type="article"
  keywords={d.tags}
  modifiedTime={d.updated?.toISOString()}
  jsonLd={[
    creativeWorkSchema({
      type: 'CreativeWork',
      name: d.title,
      description: d.summary,
      path,
      dateModified: d.updated,
      keywords: d.tags,
    }),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Work', path: '/work' },
      { name: d.title, path },
    ]),
  ]}
>
  <PageHead label="Project" title={d.title} lead={d.summary}>
    <dl class="facts" style="margin-top:2.5rem">
      <dt>Period</dt>
      <dd>{d.period}</dd>
      <dt>Status</dt>
      <dd>{d.status}</dd>
      {d.role && (<><dt>Role</dt><dd>{d.role}</dd></>)}
      {d.tags.length > 0 && (
        <>
          <dt>Areas</dt>
          <dd>{d.tags.join(', ')}</dd>
        </>
      )}
      {d.links.length > 0 && (
        <>
          <dt>Links</dt>
          <dd>
            {d.links.map((link, i) => (
              <>
                {i > 0 && ' · '}
                <a href={link.href} rel="noopener">{link.label}</a>
              </>
            ))}
          </dd>
        </>
      )}
    </dl>
  </PageHead>

  {d.cover && (
    <div class="wrap" style="padding-top:2.5rem">
      <Image src={d.cover} alt={d.coverAlt ?? d.title} widths={[480, 900, 1400]} sizes="(min-width: 76rem) 72rem, 100vw" loading="eager" />
    </div>
  )}

  <section class="section">
    <div class="wrap">
      <div class="doc-grid">
        <article class="doc-main prose">
          <Content />
        </article>

        <aside class="doc-aside">
          <nav class="toc" aria-label="On this page">
            <p class="label">On this page</p>
            <ul>
              {headings
                .filter((h) => h.depth === 2)
                .map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
            </ul>
          </nav>
        </aside>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <a class="arrow" href="/work">Back to all work</a>
    </div>
  </section>
</BaseLayout>
