---
import { withBase, absoluteUrl } from '../lib/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { ORIGIN, SITE } from '../consts';
import { personSchema, breadcrumbSchema } from '../lib/schema';

const description = `Contact James Williams, geospatial data developer, ${SITE.location.region}, ${SITE.location.country}.`;
---

<BaseLayout
  title="Contact"
  description={description}
  jsonLd={[
    personSchema(),
    {
      '@context': 'https://schema.org',
      '@type': 'ContactPage',
      url: absoluteUrl(ORIGIN, '/contact'),
      name: 'Contact',
      description,
      mainEntity: { '@id': `${SITE.url}/#person` },
    },
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Contact', path: '/contact' },
    ]),
  ]}
>
  <PageHead
    label="Contact"
    title="Get in touch"
    lead="Open to data and platform engineering roles, consulting and research collaboration. Email is read properly and answered within a couple of days."
  />

  <section class="section">
    <div class="wrap">
      <div class="split">
        <p class="label">Details</p>
        <dl class="facts">
          <dt>Email</dt>
          <dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>

          <dt>Location</dt>
          <dd>{SITE.location.region}, {SITE.location.country}</dd>

          {SITE.profiles
            .filter((p) => p.sameAs)
            .map((profile) => (
              <>
                <dt>{profile.label}</dt>
                <dd><a href={profile.href} rel="me noopener">{profile.href.replace(/^https?:\/\/(www\.)?/, '')}</a></dd>
              </>
            ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="split">
        <p class="label">Enquiries</p>
        <div class="stack">
          <p class="note">
            For roles, the CV is the fastest read and I am happy to talk through
            any of the systems on this site in detail. For consulting, a short
            note on the problem, the data you already hold and the deadline is
            enough to start.
          </p>
          <div class="inline-links">
            <a class="chip is-solid" href={`mailto:${SITE.email}`}>Send an email</a>
            <a class="chip" href={withBase('/cv.pdf')}>Download CV</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
